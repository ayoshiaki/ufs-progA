# Template dos segredos do app. COPIE para `.streamlit/secrets.toml` e preencha.
# O arquivo real (secrets.toml) NÃO vai para o git — só este .example vai.
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Gere uma senha forte, por exemplo:
#     python -c "import secrets; print(secrets.token_urlsafe(18))"
#
# No Streamlit Community Cloud, defina estes valores em Settings → Secrets
# (não suba o secrets.toml).

# Senha da Admin View (acesse o app com ?user=admin para ver estatísticas).
ADMIN_PASSWORD = "troque-por-uma-senha-forte"

# (Opcional) URL pública do app, usada no cartão "Salvar progresso".
# APP_URL = "https://seu-app.streamlit.app"
